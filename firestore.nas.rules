rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // NAS mode uses Firestore only as an FCM token registry. Each anonymous
    // Firebase user may write only a token record bound to its own UID.
    match /notification_tokens/{tokenId} {
      function isValidTokenWrite() {
        return request.auth != null
          && request.resource.data.keys().hasAll([
            'token', 'deviceId', 'platform', 'backend', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'token', 'deviceId', 'platform', 'backend', 'updatedAt'
          ])
          && request.resource.data.deviceId == request.auth.uid
          && request.resource.data.backend == 'nas'
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.platform is string
          && request.resource.data.updatedAt == request.time;
      }

      allow create, update: if isValidTokenWrite();
      allow read, delete: if false;
    }

    // NAS API and Cloud Functions use privileged server credentials.
    // Deny every other client-side Firestore access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
