# Copy to .env on the NAS. Generate each value independently with:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DATEPDF_NAS_TOKEN=replace-with-a-random-user-token-at-least-32-characters
DATEPDF_NAS_ADMIN_TOKEN=replace-with-a-different-random-admin-token-at-least-32-characters
# Optional FCM push relay. Set both after deploying functions/notifyNasEvent.
DATEPDF_NAS_PUSH_URL=
DATEPDF_NAS_PUSH_SECRET=
